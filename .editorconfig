root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Keep declarations multiline when they have multiple parameters
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2

ktlint_code_style = android_studio

# Compose functions use PascalCase
ktlint_function_naming_ignore_when_annotated_with = Composable

# Keep trailing commas in multiline declarations and calls
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Catch imports left behind after refactoring.
ktlint_standard_no-unused-imports = enabled